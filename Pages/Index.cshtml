@page
@model IndexModel
@{
    ViewData["Title"] = "Food trucks nearby";
}

<div class="container py-4">
    <h1 class="mb-3">Najdi food truck poblíž</h1>
    <p class="text-muted">Zadej polohu a volitelně typ jídla. Výsledky jsou seřazené podle vzdálenosti.</p>

    <form method="get" class="row g-3 align-items-end mb-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-sm-6 col-lg-3">
            <label asp-for="SearchLatitude" class="form-label">Zeměpisná šířka</label>
            <input asp-for="SearchLatitude" type="number" step="any" class="form-control" />
            <span asp-validation-for="SearchLatitude" class="text-danger"></span>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label asp-for="SearchLongitude" class="form-label">Zeměpisná délka</label>
            <input asp-for="SearchLongitude" type="number" step="any" class="form-control" />
            <span asp-validation-for="SearchLongitude" class="text-danger"></span>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="SearchAmount" class="form-label">Počet výsledků (1–50)</label>
            <input asp-for="SearchAmount" type="number" min="1" max="50" class="form-control" />
            <span asp-validation-for="SearchAmount" class="text-danger"></span>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="SearchFood" class="form-label">Oblíbené jídlo</label>
            <input asp-for="SearchFood" class="form-control" placeholder="např. tacos" />
            <span asp-validation-for="SearchFood" class="text-danger"></span>
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-primary w-100">Hledat</button>
        </div>
    </form>

    @if (Model.FoodTrucks.Count == 0 && ViewData.ModelState.IsValid)
    {
        <p>Nenašli se žádní food trucky odpovídající hledání.</p>
    }
    else if (Model.FoodTrucks.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Název</th>
                        <th scope="col">Jídlo</th>
                        <th scope="col">Adresa</th>
                        <th scope="col">Vzdálenost</th>
                        <th scope="col">Stav</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var foodTruck in Model.FoodTrucks)
                    {
                        <tr>
                            <td>@foodTruck.Applicant</td>
                            <td>@foodTruck.FoodItems</td>
                            <td>@foodTruck.Address</td>
                            <td>@((foodTruck.CalculateDistance(Model.SearchLatitude, Model.SearchLongitude) / 1000).ToString("0.0")) km</td>
                            <td>@foodTruck.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
